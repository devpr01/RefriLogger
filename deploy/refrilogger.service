[Unit]
Description=Refrigeration Logger Service
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=refrilogger
Group=refrilogger
WorkingDirectory=/opt/refrilogger
ExecStart=/opt/refrilogger/refrilogger
Restart=always
RestartSec=5
TimeoutStopSec=30

# /var/lib/refrilogger is created and owned by the service user automatically
StateDirectory=refrilogger
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=Storage__DbPath=/var/lib/refrilogger/logger.db
# Optional secrets/overrides, e.g.  Security__ApiKey=change-me   Simulator__Enabled=false
EnvironmentFile=-/etc/refrilogger/refrilogger.env

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
