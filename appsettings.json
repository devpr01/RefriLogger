{
  "Urls": "http://0.0.0.0:5080",
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Storage": {
    "DbPath": "data/logger.db",
    "RetentionDays": 30
  },
